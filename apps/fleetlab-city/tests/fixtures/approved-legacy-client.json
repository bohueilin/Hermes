    "index.html": "<!doctype html>\n<html lang=\"en\">\n<head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>FleetLab | Test fleet decisions in simulation</title>\n<meta name=\"description\" content=\"A browser-based teaching simulator for autonomous-vehicle fleet operations. Run a synthetic fleet day, change one constraint, and inspect the trade-offs. Simulation only.\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"FleetLab | Test fleet decisions in simulation\">\n<meta property=\"og:description\" content=\"Run a synthetic fleet day, change one constraint, and inspect the trade-offs. Four teaching models with explicit limits; no operational authority.\">\n<meta name=\"twitter:card\" content=\"summary\">\n<link rel=\"stylesheet\" href=\"./styles.css\">\n</head>\n<body>\n<noscript>FleetLab needs JavaScript to explore its synthetic teaching models. It runs in your browser with no account. Simulation only; NOT_EVIDENCE; decision authority NONE.</noscript>\n<div id=\"fleetlab-root\" class=\"fl-app\" data-phone-group=\"now\">\n<div id=\"fleetlab-teaching-strip\" class=\"fl-strip\"></div>\n</div>\n<script type=\"module\" src=\"./boot.js\"></script>\n</body>\n</html>\n",
